{
  "name": "game-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "oxlint src scripts tests --ignore-pattern src/features/abertura/logoGas/gas-logo.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:all": "vitest run",
    "sim:partidas": "node scripts/sim-partidas.ts",
    "android:apk": "cd android && gradlew assembleProducaoDebug",
    "android:apk:local": "npm run build && cd android && gradlew assembleLocalDebug"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^3.2.0",
    "wrangler": "4.158.0"
  },
  "dependencies": {
    "i18next": "^26.7.1",
    "lottie-web": "^5.12.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.11"
  }
}
