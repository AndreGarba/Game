// Site estático do jogo: só static assets, sem código de Worker.
// Quem publica é o Workers Builds (integração Git do Cloudflare), a cada push na main:
// build `npm ci && npm run build`, deploy `npx wrangler deploy`. Nunca `wrangler deploy` à mão.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Tem que ser igual ao nome do Worker no painel: o Workers Builds recusa o build se divergir.
  "name": "game",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Sem router: caminho inexistente responde 404 de verdade. Um fallback de SPA responderia
    // 200 text/html também para /assets/<hash>.js de um deploy antigo, e o import() do chunk
    // quebraria com erro de MIME em vez de 404. Offline, quem atende a navegação é o service worker.
    "not_found_handling": "404-page"
  },
  // Ligado no painel pelo dono do jogo (game.andre-garbeline.workers.dev). O deploy aplica este
  // valor: false aqui desligaria a URL no próximo push.
  "workers_dev": true,
  "preview_urls": false
}
