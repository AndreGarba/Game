// Site estático do jogo: só static assets, sem código de Worker.
// Quem publica é o job "deploy" do CI, depois do merge na main. Nunca `wrangler deploy` à mão.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Jogo novo: troque o nome do Worker antes do primeiro deploy (vira <nome>.<conta>.workers.dev).
  "name": "game-template",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Sem router: caminho inexistente responde 404 de verdade. Um fallback de SPA responderia
    // 200 text/html também para /assets/<hash>.js de um deploy antigo, e o import() do chunk
    // quebraria com erro de MIME em vez de 404. Offline, quem atende a navegação é o service worker.
    "not_found_handling": "404-page"
  },
  // Desligado até decidir quem pode abrir o jogo: o primeiro deploy sai sem URL pública. Ligar
  // (true) é decisão do dono do jogo, depois de configurar o acesso no Cloudflare se precisar.
  "workers_dev": false,
  "preview_urls": false
}
