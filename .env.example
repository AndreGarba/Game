# Ranking (Supabase). Só a URL e a chave publishable: a mesma que vai para o navegador.
# Sem estas duas, o jogo roda e o ranking some da tela.
VITE_SUPABASE_URL=https://<id-do-projeto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Só para scripts/musica/gerar-trilhas.ts, nunca para o navegador (sem prefixo VITE_). Fica em
# .env.local, criado por `npx -y @elevenlabs/cli@latest onboard init`.
ELEVENLABS_API_KEY=
